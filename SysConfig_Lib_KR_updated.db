TYPE "CW_DIG"
VERSION : 0.1
   STRUCT
      AUTO_CMD { ExternalWritable := 'False'} : Bool;   // Auto command
      FORCE : Bool;   // Force command
      SPARE { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      ENABLE { S7_SetPoint := 'True'} : Bool;   // Master enable
      SPARE4 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      INPUT { ExternalWritable := 'False'} : Bool;   // Input Status
      SPARE6 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      SPARE7 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      SPARE8 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      SPARE9 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      SPARE10 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      SPARE11 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      SPARE12 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      EXIST { S7_SetPoint := 'True'} : Bool;   // Exist
      OUT_ACT { ExternalWritable := 'False'} : Bool;   // Output activation
      SPARE15 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
   END_STRUCT;

END_TYPE

TYPE "CW_MTR"
VERSION : 0.1
   STRUCT
      START_REQ { ExternalWritable := 'False'} : Bool;   // Start request
      FORCE : Bool;   // Force command
      RST_REQ : Bool;   // Reset request
      ENABLE { S7_SetPoint := 'True'} : Bool;   // Master enable
      FB_RDY { ExternalWritable := 'False'} : Bool;   // Feedback Ready/Trip
      FB_RUN { ExternalWritable := 'False'} : Bool;   // Feedback Run
      FB_RDY_EN { S7_SetPoint := 'True'} : Bool;   // Enable Ready/Trip Feedback
      FB_RUN_EN { S7_SetPoint := 'True'} : Bool;   // Enable Run Feedback
      SPARE9 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      NO_ERR { ExternalWritable := 'False'} : Bool;   // No error
      SRV_RST : Bool;   // Reset service interval
      SRV_IND { ExternalWritable := 'False'} : Bool;   // Service interval elapsed
      SPARE1 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      EXIST { S7_SetPoint := 'True'} : Bool;   // Exist
      OUT_ACT { ExternalWritable := 'False'} : Bool;   // Output activation
      SPARE2 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
   END_STRUCT;

END_TYPE

TYPE "CW_AN"
VERSION : 0.1
   STRUCT
      SPARE0 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      FORCE : Bool;   // Force output
      SP_CHANGE : Bool;   // Setpoint change trigger
      ENABLE { S7_SetPoint := 'True'} : Bool;   // 1=Master enable
      SPARE4 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      OPEN { ExternalWritable := 'False'} : Bool;   // PLC request > 0.1
      SPARE6 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      SPARE7 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      SPARE8 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      NO_ERR { ExternalWritable := 'False'} : Bool;   // 1=No error
      PAR_CHANGE : Bool;   // Parameter change trigger
      SPARE11 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      NO { S7_SetPoint := 'True'} : Bool;   // 0=NC, 1=NO
      EXIST { S7_SetPoint := 'True'} : Bool;   // 1=Exist
      SPARE14 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      SPARE15 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
   END_STRUCT;

END_TYPE

TYPE "CW_VLV"
VERSION : 0.1
   STRUCT
      AUTO_CMD { ExternalWritable := 'False'} : Bool;   // Auto command
      FORCE : Bool;   // Force command
      SPARE2 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;   // Setpoint change indication
      ENABLE { S7_SetPoint := 'True'} : Bool;   // Master enable
      FB_CLS { ExternalWritable := 'False'} : Bool;   // Feedback Close
      FB_OPN { ExternalWritable := 'False'} : Bool;   // Feedback Open
      FB_CLS_EN { S7_SetPoint := 'True'} : Bool;   // Enable Close Feedback
      FB_OPN_EN { S7_SetPoint := 'True'} : Bool;   // Enable Open Feedback
      OPN_REQ { ExternalWritable := 'False'} : Bool;   // Open Request
      NO_ERR { ExternalWritable := 'False'} : Bool;   // No error
      SRV_RST : Bool;   // Reset service interval
      SRV_IND { ExternalWritable := 'False'} : Bool;   // Service interval elapsed
      NO { S7_SetPoint := 'True'} : Bool;   // NO/NC
      EXIST { S7_SetPoint := 'True'} : Bool;   // Valve exist
      OUT_ACT { ExternalWritable := 'False'} : Bool;   // Output activation
      VLV_W_FB { S7_SetPoint := 'True'} : Bool;   // Valve without position feedbacks
   END_STRUCT;

END_TYPE

